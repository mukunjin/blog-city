{
  "name": "blog-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "中文独立博客列表，变成一座 3D 像素城市",
  "scripts": {
    "data": "node scripts/build-blogs.mjs",
    "dev": "vite --port 3210",
    "build": "vite build",
    "build:ci": "node scripts/build-blogs.mjs && vite build",
    "preview": "vite preview --port 3210",
    "deploy": "npm run build:ci && npx wrangler pages deploy dist --project-name blog-city --branch main",
    "sync": "node scripts/sync-health.mjs && node scripts/build-blogs.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "^4.153.0"
  }
}
