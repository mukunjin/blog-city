// Cloudflare Workers, static assets only: `npm run build` writes ./dist and
// `wrangler deploy` publishes it to the edge. No database, no server runtime.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-city",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
